# Point this at any bot you own (new or existing). Get chat ID from @userinfobot.
# (These can also be set/changed later from the Settings page in the app itself.)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Free key from https://api.data.gov/signup/ — DEMO_KEY works but is rate-limited
USDA_API_KEY=DEMO_KEY

# Optional: powers the AI chat assistant, quick-add, and transaction
# auto-categorization features. Free key (no credit card) from
# https://aistudio.google.com/apikey. Left blank, those features just show
# a "not configured" message — everything else works fine without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TIMEZONE=Africa/Addis_Ababa
REMINDER_HOUR=9
NUDGE_HOUR=20
WEEK_END_DAY=6

# Optional lightweight access gate — RETIRED. Real per-user login (email +
# password, with signup at /register) replaced this. Left unused for
# backward compatibility; no need to set it anymore.
APP_ACCESS_TOKEN=

# Password reset emails — standard SMTP. Works with a free Gmail "App
# Password" (myaccount.google.com/apppasswords), or any other SMTP provider.
# If left blank, registration/login still work fine — only "forgot password"
# emails won't be able to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Your deployed URL, used to build the reset link in the email, e.g.:
# https://lifehub-g8z9.onrender.com
APP_BASE_URL=

# Where the sqlite DB + uploaded ID photos live. Point at a Railway/Render
# volume (e.g. /data) in production so it survives redeploys.
DATA_DIR=

# Optional: if both are set, the DB is stored on Turso (remote SQLite-
# compatible DB) instead of a local sqlite file — survives Render free-tier
# restarts without needing a paid disk. Get these from https://turso.tech
# after `turso db create lifehub` + `turso db show lifehub --url` +
# `turso db tokens create lifehub`. NOTE: this only covers the database —
# uploaded ID vault photos are still local files and still reset unless
# DATA_DIR points at a persistent disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: ID Vault file storage (Backblaze B2, S3-compatible). If all three
# are set, uploaded vault photos/PDFs go to B2 instead of local disk, so they
# survive Render restarts and redeploys. Create a free B2 account + bucket at
# https://www.backblaze.com/b2 , then Account → App Keys → Add a New
# Application Key (scoped to the bucket). B2_ENDPOINT_URL is the bucket's
# "S3 Compatible" endpoint shown on the bucket details page, e.g.
# https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=lifehub-vault
B2_ENDPOINT_URL=

# Required. Signs session cookies AND (see crypto.py) derives the vault's
# password-encryption key — the app refuses to start without this unless
# FLASK_ENV=development. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable/backed-up once you start storing real data: if it ever
# changes, every stored vault password becomes undecryptable.
FLASK_SECRET_KEY=change-me-to-something-random

# Set to "development" for local work (allows a placeholder secret key,
# disables the Secure cookie flag so http://localhost still works). Leave
# unset/"production" for any real deployment.
FLASK_ENV=development

# Optional: max upload size in MB for /vault/upload (default 20).
MAX_UPLOAD_MB=20

# Optional: how many days a login session stays valid (default 7).
SESSION_LIFETIME_DAYS=7
