# Point this at any bot you own (new or existing). Get chat ID from @userinfobot.
# (These can also be set/changed later from the Settings page in the app itself.)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Free key from https://api.data.gov/signup/ — DEMO_KEY works but is rate-limited
USDA_API_KEY=DEMO_KEY

TIMEZONE=Africa/Addis_Ababa
REMINDER_HOUR=9
NUDGE_HOUR=20
WEEK_END_DAY=6

# Optional lightweight access gate — RETIRED. Real per-user login (email +
# password, with signup at /register) replaced this. Left unused for
# backward compatibility; no need to set it anymore.
APP_ACCESS_TOKEN=

# Password reset emails — standard SMTP. Works with a free Gmail "App
# Password" (myaccount.google.com/apppasswords), or any other SMTP provider.
# If left blank, registration/login still work fine — only "forgot password"
# emails won't be able to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Your deployed URL, used to build the reset link in the email, e.g.:
# https://lifehub-g8z9.onrender.com
APP_BASE_URL=

# Where the sqlite DB + uploaded ID photos live. Point at a Railway/Render
# volume (e.g. /data) in production so it survives redeploys.
DATA_DIR=

# Optional: if both are set, the DB is stored on Turso (remote SQLite-
# compatible DB) instead of a local sqlite file — survives Render free-tier
# restarts without needing a paid disk. Get these from https://turso.tech
# after `turso db create lifehub` + `turso db show lifehub --url` +
# `turso db tokens create lifehub`. NOTE: this only covers the database —
# uploaded ID vault photos are still local files and still reset unless
# DATA_DIR points at a persistent disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

FLASK_SECRET_KEY=change-me-to-something-random
